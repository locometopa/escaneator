{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Escaneator",
  "version": "0.1.0",
  "identifier": "es.escaneator.escritorio",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Escaneator",
        "width": 1320,
        "height": 840,
        "minWidth": 1040,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "languages": ["Spanish"],
        "installMode": "both"
      }
    }
  }
}
